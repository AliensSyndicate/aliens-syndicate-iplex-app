# iPlex App — DESENVOLVIMENTO (independente da produção)
# Destino: página de teste controlada deste repositório (index.html), que faz o
# papel do iPlex Web: handshake da ponte e teste do player.
#  - npm run dev: servida pelo Vite ao lado do shell.
#  - npm run tv:  servida pelo Mac na rede local (o script substitui esta URL).
# Para testar outro endereço de desenvolvimento (ex.: um iPlex Web de homologação),
# defina VITE_IPLEX_TARGET_URL em .env.development.local.
VITE_IPLEX_ENV=development
VITE_IPLEX_TARGET_URL=./index.html

# Mídia usada SOMENTE pela página de teste no teste do player (HLS público de testes da Mux).
VITE_IPLEX_TEST_MEDIA_URL=https://test-streams.mux.dev/x36xhzz/x36xhzz.m3u8
