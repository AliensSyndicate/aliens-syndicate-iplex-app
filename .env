# iPlex App (Smart TVs) — configuração comum a todos os ambientes.
# Lida pelo Vite (somente VITE_* chega ao app) e pelos scripts de build/TV.
#
# Destino por ambiente (NÃO definir aqui):
#   .env.production   -> URL de produção do iPlex Web
#   .env.development  -> página de teste controlada
# Substituições locais (não versionadas): .env.local / .env.<ambiente>.local

# frame (padrão): iPlex Web em <iframe> com a ponte (APIs da TV, AVPlay).
# navigate: navegação de nível superior, sem ponte.
VITE_IPLEX_LOAD_MODE=frame

# Tempo máximo (ms) da verificação de disponibilidade do destino.
VITE_IPLEX_PROBE_TIMEOUT_MS=8000

# Tempo máximo (ms) para o frontend responder app.ready (frame) ou a navegação concluir (navigate).
VITE_IPLEX_LOAD_TIMEOUT_MS=20000

# ---- Somente empacotamento Tizen (não exposto ao app) ----

# Hosts extras liberados em <access> e <tizen:allow-navigation> (https, com subdomínios),
# separados por espaço. O host do destino é incluído automaticamente.
IPLEX_TIZEN_EXTRA_HOSTS=

# Título na TV (igual ao título padrão no Seller Office), versão do widget (x.y.z)
# e perfil de assinatura do Tizen CLI usado em desenvolvimento.
IPLEX_TIZEN_APP_NAME=iPlex TV
IPLEX_TIZEN_VERSION=1.0.0
IPLEX_TIZEN_SIGNING_PROFILE=iplex-tv

# Perfil de assinatura da LOJA (certificado Samsung: autor + distribuidor), usado por
# `npm run release:tizen`. O mesmo autor deve assinar todas as atualizações publicadas.
IPLEX_TIZEN_RELEASE_PROFILE=iplex-tv

# ---- Automação "npm run tv" / iPlex-TV.command ----
# IP e porta SDB da Samsung (Modo Desenvolvedor). Para outra TV, altere aqui,
# crie um .env.local com IPLEX_TV_HOST=..., ou use: npm run tv -- --host <IP>
IPLEX_TV_HOST=192.168.15.8
IPLEX_TV_SDB_PORT=26101
# Ambiente instalado pelo npm run tv: production (padrão: sempre a última versão
# do app de produção) | development (página de teste servida pelo Mac).
IPLEX_TV_ENV=production
# true: com o iPlex Web ainda não publicado, o npm run tv instala mesmo assim
# (avisa e valida a tela "iPlex indisponível"). A trava rígida fica no release:tizen.
IPLEX_TV_ALLOW_UNPUBLISHED=true
# Tentativas de conexão (limitadas) e espera da confirmação vinda da TV.
IPLEX_TV_CONNECT_ATTEMPTS=3
IPLEX_TV_VALIDATE_TIMEOUT_MS=180000
# Porta do servidor de desenvolvimento no Mac (página de teste + receptor de eventos).
IPLEX_TV_REPORT_PORT=8765
